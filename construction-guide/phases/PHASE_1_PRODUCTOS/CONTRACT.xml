  <!--
    ═══════════════════════════════════════════════════════
    INVARIANTES DEL SISTEMA (para Phase 1)
    ═══════════════════════════════════════════════════════
  -->
  <invariants>
    <invariant id="INV-001">Todo producto debe tener al menos: nombre, sku, categoria_id, costo_adquisicion, precio_venta, unidad_compra_id, unidad_venta_id, factor_conversion.</invariant>
    <invariant id="INV-002">precio_venta SIEMPRE mayor que costo_adquisicion. Sin excepción.</invariant>
    <invariant id="INV-003">SKU SIEMPRE único en el sistema. Verificar antes de guardar.</invariant>
    <invariant id="INV-004">margen_ganancia SIEMPRE derivado, nunca guardado directamente.</invariant>
    <invariant id="INV-005">Productos eliminados NO se borran. Se marcan como estado="descontinuado".</invariant>
  </invariants>

</artifact>
